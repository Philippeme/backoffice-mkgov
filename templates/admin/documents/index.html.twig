{% extends 'admin/layout/base.html.twig' %}

{% block title %}{{ page_title }} - MK Gov Admin{% endblock %}

{% block page_header %}
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">
                    <i class="fas fa-cogs me-2"></i>
                    {{ page_title }}
                </h1>
                <p class="page-subtitle text-muted">Define and manage service procedures and workflows</p>
            </div>
            <div class="col-auto">
                <div class="btn-group">
                    <a href="{{ path('admin_procedures_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>
                        New Procedure
                    </a>
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-tools me-1"></i>
                        Tools
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#importModal">
                            <i class="fas fa-upload me-2"></i>Import Procedures</a></li>
                        <li><a class="dropdown-item" href="#" onclick="exportProcedures()">
                            <i class="fas fa-download me-2"></i>Export Procedures</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" onclick="validateAllWorkflows()">
                            <i class="fas fa-check-circle me-2"></i>Validate All Workflows</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-cogs fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0">{{ procedures.getTotalItemCount }}</div>
                            <div class="small">Total Procedures</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0" id="activeCount">--</div>
                            <div class="small">Active</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-edit fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0" id="draftCount">--</div>
                            <div class="small">Draft</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-clock fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0" id="avgDuration">--</div>
                            <div class="small">Avg. Duration (days)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-filter me-2"></i>
                Filter Procedures
            </h5>
        </div>
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" name="search" value="{{ app.request.query.get('search') }}" placeholder="Search procedures...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Category</label>
                    <select class="form-select" name="category">
                        <option value="">All Categories</option>
                        <option value="police_justice" {{ app.request.query.get('category') == 'police_justice' ? 'selected' : '' }}>Police & Justice</option>
                        <option value="family" {{ app.request.query.get('category') == 'family' ? 'selected' : '' }}>Family</option>
                        <option value="transport" {{ app.request.query.get('category') == 'transport' ? 'selected' : '' }}>Transport</option>
                        <option value="education" {{ app.request.query.get('category') == 'education' ? 'selected' : '' }}>Education</option>
                        <option value="business" {{ app.request.query.get('category') == 'business' ? 'selected' : '' }}>Business</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <option value="">All Status</option>
                        <option value="draft" {{ app.request.query.get('status') == 'draft' ? 'selected' : '' }}>Draft</option>
                        <option value="active" {{ app.request.query.get('status') == 'active' ? 'selected' : '' }}>Active</option>
                        <option value="inactive" {{ app.request.query.get('status') == 'inactive' ? 'selected' : '' }}>Inactive</option>
                        <option value="archived" {{ app.request.query.get('status') == 'archived' ? 'selected' : '' }}>Archived</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Duration Range</label>
                    <select class="form-select" name="duration">
                        <option value="">Any Duration</option>
                        <option value="1-5" {{ app.request.query.get('duration') == '1-5' ? 'selected' : '' }}>1-5 days</option>
                        <option value="6-15" {{ app.request.query.get('duration') == '6-15' ? 'selected' : '' }}>6-15 days</option>
                        <option value="16-30" {{ app.request.query.get('duration') == '16-30' ? 'selected' : '' }}>16-30 days</option>
                        <option value="30+" {{ app.request.query.get('duration') == '30+' ? 'selected' : '' }}>30+ days</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-search me-1"></i>
                            Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Procedures List -->
    <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="card-title mb-0">Procedures List</h5>
                </div>
                <div class="col-auto">
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="bulkActions" disabled>
                            <i class="fas fa-check-square me-1"></i>
                            Bulk Actions
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" disabled>
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" data-action="activate">Activate Selected</a></li>
                            <li><a class="dropdown-item" href="#" data-action="deactivate">Deactivate Selected</a></li>
                            <li><a class="dropdown-item" href="#" data-action="duplicate">Duplicate Selected</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" data-action="delete">Delete Selected</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            {% if procedures.items|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th width="40">
                                    <input type="checkbox" class="form-check-input" id="selectAll">
                                </th>
                                <th>Procedure</th>
                                <th>Category</th>
                                <th>Duration</th>
                                <th>Cost</th>
                                <th>Status</th>
                                <th>Workflow</th>
                                <th>Usage</th>
                                <th width="140">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for procedure in procedures %}
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input procedure-checkbox" value="{{ procedure.id }}">
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="procedure-icon me-3">
                                                {% set categoryIcons = {
                                                    'police_justice': 'fas fa-shield-alt',
                                                    'family': 'fas fa-users',
                                                    'transport': 'fas fa-car',
                                                    'education': 'fas fa-graduation-cap',
                                                    'business': 'fas fa-briefcase'
                                                } %}
                                                <i class="{{ categoryIcons[procedure.category] ?? 'fas fa-cog' }} text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-medium">{{ procedure.name }}</div>
                                                {% if procedure.description %}
                                                    <small class="text-muted">{{ procedure.description|length > 60 ? procedure.description|slice(0, 60) ~ '...' : procedure.description }}</small>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ procedure.category|replace('_', ' ')|title }}</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">{{ procedure.estimatedDuration }} days</span>
                                    </td>
                                    <td>
                                        {% if procedure.cost > 0 %}
                                            <span class="fw-medium">{{ procedure.cost|number_format(0, ',', ' ') }} {{ procedure.currency }}</span>
                                        {% else %}
                                            <span class="text-muted">Free</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set statusClass = {
                                            'draft': 'secondary',
                                            'active': 'success',
                                            'inactive': 'warning',
                                            'archived': 'dark'
                                        } %}
                                        <span class="badge bg-{{ statusClass[procedure.status] ?? 'secondary' }}">
                                            {{ procedure.status|title }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if procedure.workflowSteps|length > 0 %}
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                                    <div class="progress-bar bg-info" style="width: 100%"></div>
                                                </div>
                                                <small class="text-muted">{{ procedure.workflowSteps|length }} steps</small>
                                            </div>
                                        {% else %}
                                            <span class="text-danger small">
                                                <i class="fas fa-exclamation-triangle me-1"></i>
                                                No workflow
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set usageCount = procedure.requests|length %}
                                        <span class="badge bg-{{ usageCount > 10 ? 'success' : (usageCount > 0 ? 'info' : 'light text-dark') }}">
                                            {{ usageCount }} requests
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ path('admin_procedures_show', {id: procedure.id}) }}" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('admin_procedures_edit', {id: procedure.id}) }}" class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="{{ path('admin_procedures_workflow', {id: procedure.id}) }}" class="btn btn-outline-info" title="Manage Workflow">
                                                <i class="fas fa-project-diagram"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-warning dropdown-toggle" data-bs-toggle="dropdown" title="More Actions">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="{{ path('admin_procedures_duplicate', {id: procedure.id}) }}">
                                                    <i class="fas fa-copy me-2"></i>Duplicate</a></li>
                                                <li><a class="dropdown-item" href="#" onclick="exportProcedure({{ procedure.id }})">
                                                    <i class="fas fa-download me-2"></i>Export</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger" href="#" onclick="deleteProcedure({{ procedure.id }})">
                                                    <i class="fas fa-trash me-2"></i>Delete</a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <nav aria-label="Procedures pagination">
                    {{ knp_pagination_render(procedures) }}
                </nav>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-cogs fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No procedures found</h5>
                    <p class="text-muted">Create your first procedure to get started.</p>
                    <a href="{{ path('admin_procedures_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>
                        Create Procedure
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Import Modal -->
    <div class="modal fade" id="importModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-upload me-2"></i>
                        Import Procedures
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="importForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Select Import File</label>
                            <input type="file" class="form-control" name="import_file" accept=".json,.csv,.xlsx" required>
                            <div class="form-text">Supported formats: JSON, CSV, Excel</div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="overwriteExisting" name="overwrite">
                                <label class="form-check-label" for="overwriteExisting">
                                    Overwrite existing procedures with same name
                                </label>
                            </div>
                        </div>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Note:</strong> Import will validate all procedure data before creating entries.
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="importForm" class="btn btn-primary">
                        <i class="fas fa-upload me-1"></i>
                        Import Procedures
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        // Load statistics
        document.addEventListener('DOMContentLoaded', function() {
            loadProcedureStats();
        });

        function loadProcedureStats() {
            const procedures = {{ procedures.items|json_encode|raw }};
            
            const activeCount = procedures.filter(p => p.status === 'active').length;
            const draftCount = procedures.filter(p => p.status === 'draft').length;
            const avgDuration = procedures.length > 0 ? 
                Math.round(procedures.reduce((sum, p) => sum + p.estimatedDuration, 0) / procedures.length) : 0;
            
            document.getElementById('activeCount').textContent = activeCount;
            document.getElementById('draftCount').textContent = draftCount;
            document.getElementById('avgDuration').textContent = avgDuration;
        }

        // Select all functionality
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.procedure-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateBulkActions();
        });

        // Individual checkbox functionality
        document.querySelectorAll('.procedure-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateBulkActions);
        });

        function updateBulkActions() {
            const checkedBoxes = document.querySelectorAll('.procedure-checkbox:checked');
            const bulkButton = document.getElementById('bulkActions');
            const dropdownToggle = bulkButton.nextElementSibling;
            
            if (checkedBoxes.length > 0) {
                bulkButton.disabled = false;
                dropdownToggle.disabled = false;
                bulkButton.innerHTML = `<i class="fas fa-check-square me-1"></i>${checkedBoxes.length} Selected`;
            } else {
                bulkButton.disabled = true;
                dropdownToggle.disabled = true;
                bulkButton.innerHTML = '<i class="fas fa-check-square me-1"></i>Bulk Actions';
            }
        }

        function deleteProcedure(procedureId) {
            if (confirm('Are you sure you want to delete this procedure? This action cannot be undone.')) {
                fetch(`/admin/procedures/${procedureId}`, {
                    method: 'DELETE',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Error deleting procedure');
                    }
                });
            }
        }

        function exportProcedure(procedureId) {
            window.open(`/admin/procedures/${procedureId}/export`, '_blank');
        }

        function exportProcedures() {
            const selectedIds = Array.from(document.querySelectorAll('.procedure-checkbox:checked')).map(cb => cb.value);
            let url = '/admin/procedures/export';
            
            if (selectedIds.length > 0) {
                url += '?ids=' + selectedIds.join(',');
            }
            
            window.open(url, '_blank');
        }

        function validateAllWorkflows() {
            const button = event.target;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Validating...';
            button.disabled = true;
            
            fetch('/admin/procedures/api/validate-workflows', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.valid) {
                    alert(`All workflows are valid! Checked ${data.count} procedures.`);
                } else {
                    alert(`Found ${data.errors.length} workflow validation errors. Check the logs for details.`);
                }
            })
            .finally(() => {
                button.innerHTML = '<i class="fas fa-check-circle me-2"></i>Validate All Workflows';
                button.disabled = false;
            });
        }

        // Import form handling
        document.getElementById('importForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const submitButton = this.querySelector('button[type="submit"]');
            
            submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Importing...';
            submitButton.disabled = true;
            
            fetch('/admin/procedures/import', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`Successfully imported ${data.count} procedures!`);
                    location.reload();
                } else {
                    alert('Import failed: ' + data.message);
                }
            })
            .finally(() => {
                submitButton.innerHTML = '<i class="fas fa-upload me-1"></i>Import Procedures';
                submitButton.disabled = false;
            });
        });

        // Bulk actions
        document.querySelectorAll('[data-action]').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const action = this.dataset.action;
                const selectedIds = Array.from(document.querySelectorAll('.procedure-checkbox:checked')).map(cb => cb.value);
                
                if (selectedIds.length === 0) {
                    alert('Please select at least one procedure.');
                    return;
                }

                if (confirm(`Are you sure you want to ${action} ${selectedIds.length} selected procedures?`)) {
                    fetch('/admin/procedures/api/bulk-action', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            action: action,
                            ids: selectedIds
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + data.message);
                        }
                    });
                }
            });
        });
    </script>
{% endblock %}