{% extends 'admin/layout/base.html.twig' %}

{% block title %}{{ page_title }} - MK Gov Admin{% endblock %}

{% block page_header %}
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">
                    <i class="fas fa-file-alt me-2"></i>
                    {{ page_title }}
                </h1>
                <p class="page-subtitle text-muted">Monitor and manage citizen service requests</p>
            </div>
            <div class="col-auto">
                <div class="btn-group">
                    <a href="{{ path('admin_requests_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>
                        New Request
                    </a>
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-download me-1"></i>
                        Export
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#" data-export="excel"><i class="fas fa-file-excel me-2"></i>Excel</a></li>
                        <li><a class="dropdown-item" href="#" data-export="csv"><i class="fas fa-file-csv me-2"></i>CSV</a></li>
                        <li><a class="dropdown-item" href="#" data-export="pdf"><i class="fas fa-file-pdf me-2"></i>PDF Report</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-file-alt fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0">{{ requests.getTotalItemCount }}</div>
                            <div class="small">Total Requests</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-clock fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0" id="pendingCount">--</div>
                            <div class="small">Pending</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-cog fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0" id="processingCount">--</div>
                            <div class="small">Processing</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="h4 mb-0" id="completedCount">--</div>
                            <div class="small">Completed</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-filter me-2"></i>
                Filter Requests
            </h5>
        </div>
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" name="search" value="{{ app.request.query.get('search') }}" placeholder="Search by title or tracking number...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <option value="">All Status</option>
                        <option value="pending" {{ app.request.query.get('status') == 'pending' ? 'selected' : '' }}>Pending</option>
                        <option value="processing" {{ app.request.query.get('status') == 'processing' ? 'selected' : '' }}>Processing</option>
                        <option value="under_review" {{ app.request.query.get('status') == 'under_review' ? 'selected' : '' }}>Under Review</option>
                        <option value="approved" {{ app.request.query.get('status') == 'approved' ? 'selected' : '' }}>Approved</option>
                        <option value="completed" {{ app.request.query.get('status') == 'completed' ? 'selected' : '' }}>Completed</option>
                        <option value="rejected" {{ app.request.query.get('status') == 'rejected' ? 'selected' : '' }}>Rejected</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Service Family</label>
                    <select class="form-select" name="service_family">
                        <option value="">All Services</option>
                        <option value="police_justice" {{ app.request.query.get('service_family') == 'police_justice' ? 'selected' : '' }}>Police & Justice</option>
                        <option value="family" {{ app.request.query.get('service_family') == 'family' ? 'selected' : '' }}>Family</option>
                        <option value="transport" {{ app.request.query.get('service_family') == 'transport' ? 'selected' : '' }}>Transport</option>
                        <option value="education" {{ app.request.query.get('service_family') == 'education' ? 'selected' : '' }}>Education</option>
                        <option value="business" {{ app.request.query.get('service_family') == 'business' ? 'selected' : '' }}>Business</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date Range</label>
                    <input type="date" class="form-control" name="date_from" value="{{ app.request.query.get('date_from') }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <input type="date" class="form-control" name="date_to" value="{{ app.request.query.get('date_to') }}">
                </div>
                <div class="col-md-1">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Requests List -->
    <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="card-title mb-0">Requests List</h5>
                </div>
                <div class="col-auto">
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="bulkActions" disabled>
                            <i class="fas fa-check-square me-1"></i>
                            Bulk Actions
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" disabled>
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" data-action="approve">Approve Selected</a></li>
                            <li><a class="dropdown-item" href="#" data-action="reject">Reject Selected</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" data-action="delete">Delete Selected</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            {% if requests.items|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th width="40">
                                    <input type="checkbox" class="form-check-input" id="selectAll">
                                </th>
                                <th>Tracking #</th>
                                <th>Service</th>
                                <th>Citizen</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Created</th>
                                <th>Due Date</th>
                                <th width="140">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for request in requests %}
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input request-checkbox" value="{{ request.id }}">
                                    </td>
                                    <td>
                                        <span class="font-monospace text-primary">#{{ request.trackingNumber }}</span>
                                    </td>
                                    <td>
                                        <div class="fw-medium">{{ request.title }}</div>
                                        <small class="text-muted">{{ request.serviceFamily|replace('_', ' ')|title }}</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="{{ asset('images/avatars/default-avatar.png') }}" class="rounded-circle me-2" width="32" height="32">
                                            <div>
                                                <div class="fw-medium">{{ request.user.fullName }}</div>
                                                <small class="text-muted">{{ request.user.email }}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% set statusClass = {
                                            'pending': 'warning',
                                            'processing': 'info',
                                            'under_review': 'secondary',
                                            'approved': 'primary',
                                            'completed': 'success',
                                            'rejected': 'danger'
                                        } %}
                                        <span class="badge bg-{{ statusClass[request.status] ?? 'secondary' }}">
                                            {{ request.status|replace('_', ' ')|title }}
                                        </span>
                                    </td>
                                    <td>
                                        {% set priority = 'normal' %}
                                        {% if date() > request.createdAt|date_modify('+7 days') %}
                                            {% set priority = 'high' %}
                                        {% elseif date() > request.createdAt|date_modify('+3 days') %}
                                            {% set priority = 'medium' %}
                                        {% endif %}
                                        
                                        <span class="badge bg-{{ priority == 'high' ? 'danger' : (priority == 'medium' ? 'warning' : 'success') }}">
                                            {{ priority|title }}
                                        </span>
                                    </td>
                                    <td>{{ request.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        {% set dueDate = request.createdAt|date_modify('+5 days') %}
                                        <span class="{{ date() > dueDate ? 'text-danger' : 'text-muted' }}">
                                            {{ dueDate|date('d/m/Y') }}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ path('admin_requests_show', {id: request.id}) }}" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('admin_requests_edit', {id: request.id}) }}" class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            {% if request.status == 'pending' %}
                                                <button type="button" class="btn btn-outline-success" onclick="updateRequestStatus({{ request.id }}, 'processing')" title="Start Processing">
                                                    <i class="fas fa-play"></i>
                                                </button>
                                            {% elseif request.status == 'processing' %}
                                                <button type="button" class="btn btn-outline-info" onclick="updateRequestStatus({{ request.id }}, 'completed')" title="Mark Complete">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <nav aria-label="Requests pagination">
                    {{ knp_pagination_render(requests) }}
                </nav>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No requests found</h5>
                    <p class="text-muted">No service requests match your current filters.</p>
                    <a href="{{ path('admin_requests_index') }}" class="btn btn-outline-primary">
                        <i class="fas fa-refresh me-1"></i>
                        Clear Filters
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        // Load status counts
        document.addEventListener('DOMContentLoaded', function() {
            loadStatusCounts();
        });

        function loadStatusCounts() {
            // Simulate loading status counts
            document.getElementById('pendingCount').textContent = '{{ requests.items|filter(r => r.status == 'pending')|length }}';
            document.getElementById('processingCount').textContent = '{{ requests.items|filter(r => r.status == 'processing')|length }}';
            document.getElementById('completedCount').textContent = '{{ requests.items|filter(r => r.status == 'completed')|length }}';
        }

        // Select all functionality
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.request-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateBulkActions();
        });

        // Individual checkbox functionality
        document.querySelectorAll('.request-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateBulkActions);
        });

        function updateBulkActions() {
            const checkedBoxes = document.querySelectorAll('.request-checkbox:checked');
            const bulkButton = document.getElementById('bulkActions');
            const dropdownToggle = bulkButton.nextElementSibling;
            
            if (checkedBoxes.length > 0) {
                bulkButton.disabled = false;
                dropdownToggle.disabled = false;
                bulkButton.innerHTML = `<i class="fas fa-check-square me-1"></i>${checkedBoxes.length} Selected`;
            } else {
                bulkButton.disabled = true;
                dropdownToggle.disabled = true;
                bulkButton.innerHTML = '<i class="fas fa-check-square me-1"></i>Bulk Actions';
            }
        }

        function updateRequestStatus(requestId, newStatus) {
            if (confirm(`Are you sure you want to change this request status to ${newStatus}?`)) {
                // In a real implementation, this would make an AJAX call
                // For now, we'll just reload the page
                location.reload();
            }
        }

        // Bulk actions
        document.querySelectorAll('[data-action]').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const action = this.dataset.action;
                const selectedIds = Array.from(document.querySelectorAll('.request-checkbox:checked')).map(cb => cb.value);
                
                if (selectedIds.length === 0) {
                    alert('Please select at least one request.');
                    return;
                }

                if (confirm(`Are you sure you want to ${action} ${selectedIds.length} selected requests?`)) {
                    fetch('/admin/requests/api/bulk-action', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            action: action,
                            ids: selectedIds
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + data.message);
                        }
                    });
                }
            });
        });

        // Export functionality
        document.querySelectorAll('[data-export]').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const format = this.dataset.export;
                const currentUrl = new URL(window.location);
                currentUrl.pathname = `/admin/requests/export/${format}`;
                window.open(currentUrl.toString(), '_blank');
            });
        });
    </script>
{% endblock %}